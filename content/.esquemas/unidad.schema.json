{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "objetivo": {
      "type": "string",
      "minLength": 1
    },
    "estado": {
      "default": "publicada",
      "type": "string",
      "enum": [
        "borrador",
        "publicada"
      ]
    }
  },
  "required": [
    "titulo",
    "objetivo"
  ],
  "additionalProperties": false
}
