{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "nombre": {
        "type": "string",
        "minLength": 1
      },
      "definicion": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "nombre",
      "definicion"
    ],
    "additionalProperties": false
  }
}
