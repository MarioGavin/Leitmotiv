{
  "name": "leitmotiv",
  "private": true,
  "version": "0.1.0",
  "description": "PWA para aprender a componer música de videojuegos",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run content:build && vite",
    "build": "npm run content:build && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:build": "tsx scripts/contenido/compilar.ts",
    "content:check": "tsx scripts/contenido/compilar.ts --comprobar",
    "content:schemas": "tsx scripts/contenido/esquemas-json.ts",
    "samples:build": "tsx scripts/muestras/construir.ts",
    "fonts:build": "tsx scripts/fuentes/signos.ts",
    "icons:build": "tsx scripts/iconos.ts",
    "size": "tsx scripts/presupuesto.ts",
    "e2e": "playwright test",
    "audio:check": "tsx scripts/audio/comprobar.ts",
    "shots": "tsx scripts/capturas.ts",
    "check": "npm run typecheck && npm run lint && npm run content:check && npm run test && npm run build && npm run size"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "abcjs": "^6.7.1",
    "dexie": "^4.4.6",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "smplr": "^1.1.0",
    "tonal": "6.4.3",
    "tone": "^15.1.22",
    "ts-fsrs": "^5.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/jersey-15": "^5.3.0",
    "@playwright/test": "1.56.0",
    "@types/node": "^24.19.1",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "marked": "^18.0.14",
    "opentype.js": "^2.0.0",
    "oxlint": "^1.86.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
